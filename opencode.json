{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nix searcher": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-nixos"
      ]
    }
  },
  "permission": {
    "external_directory": {
      "/nix/store/**": "allow"
    },
    "edit": {
      "/nix/store/**": "deny"
    }
  }
}